{
  "name": "game-lib",
  "version": "1.0.0",
  "description": "Game library manager with scraping, archiving and metadata tools",
  "productName": "Game Lib",
  "author": "Game Lib",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:server": "node --watch server/dev.js",
    "dev:frontend": "vite",
    "standalone": "node server/standalone.js",
    "build": "electron-vite build && node scripts/prepare-packaged-server.mjs && electron-builder --dir",
    "typecheck": "vue-tsc --noEmit",
    "lint": "prettier --write \"**/*.{js,ts,vue,css,html,md,json,yml,yaml}\" && eslint --fix -c ./eslint.config.js .",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,html,md,json,yml,yaml}\" && eslint -c ./eslint.config.js .",
    "test": "cross-env NODE_ENV=test node --test server/__tests__/*.test.js",
    "smoke": "cross-env VITE_API_PORT=19700 node server/scripts/smoke-api.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.58.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.18.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "express": "^5.2.1",
    "https-proxy-agent": "^7.0.0",
    "knex": "^3.2.10",
    "nsfwjs": "^4.4.0",
    "pinia": "^3.0.1",
    "reka-ui": "^2.11.0",
    "sharp": "^0.35.4",
    "sqlite3": "^6.0.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "javascript-obfuscator": "^5.9.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "game-library",
    "electron",
    "vue",
    "vite",
    "express"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
